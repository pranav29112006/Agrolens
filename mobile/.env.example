# Copy this file to mobile/.env and fill in the values from your Supabase project:
# Dashboard -> Project Settings -> API (or the "Connect" button at the top).
# Restart the dev server after changing these.
#
# Use the anon / publishable key only. Never put the service_role (secret) key in the app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Where the AgroLens backend runs (see backend/README.md). Defaults to http://localhost:8000,
# which only works in the browser on this computer. A phone needs an address it can reach:
# the laptop's Wi-Fi address (http://192.168.x.x:8000) or a public tunnel URL.
# EXPO_PUBLIC_API_URL=http://localhost:8000
