{
  "expo": {
    "name": "AgroLens",
    "slug": "agrolens",
    "scheme": "agrolens",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4B740",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AgroLens uses your approximate location to give crop advice based on your local weather."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F3EA",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "AgroLens uses the camera to take pictures of leaves for diagnosis.",
          "photosPermission": "AgroLens lets you choose leaf pictures from your photos for diagnosis.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
