# Copy to backend/.env. Same project values as mobile/.env.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Free key from https://aistudio.google.com/apikey. With it, treatment advice is
# rewritten in the farmer's language; without it, the app shows it in English.
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODELS=["gemini-3.8-flash","gemini-3.5-flash","gemini-3.5-flash-lite"]

# Optional overrides
# CLASSIFIER_PATH=models/agrolens.onnx
# CONFIDENCE_THRESHOLD=0.6
